# No client env file is required for the normal setup.
# Development already defaults to the Node API at http://localhost:3000.
# If you need a different development API origin, set this in a local Vite
# env file such as client/.env.development.local:
# VITE_API_BASE_URL=http://localhost:3000

# Production recommendation:
# Leave VITE_API_BASE_URL unset so the browser calls same-origin /api routes
# through the production reverse proxy.
# If explicitly set, use only an origin such as https://api.example.com
# (do not include an /api path).
