# GrooveShare server environment
# Copy this file to server/.env for local development.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_ROOT=./uploads
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

PGHOST=localhost
PGPORT=5432
PGDATABASE=grooveshare_dev
PGTESTDATABASE=grooveshare_test
PGUSER=grooveshare_app
PGPASSWORD=replace-with-local-password

# Production notes:
# NODE_ENV=production
# HOST=127.0.0.1
# PORT=3000
# CLIENT_ORIGIN=https://grooveshare.example
# UPLOAD_ROOT=/var/lib/grooveshare/uploads
# Use production PostgreSQL values and a real secret for PGPASSWORD.
