# The mobile client normally uses same-origin /api requests.
# During local development, Vite proxies /api to http://127.0.0.1:3000,
# which lets the web client (5173) and mobile client (5174) run at the same time
# without widening the server CORS policy.
#
# Override only when the mobile client truly needs a separate API origin:
# VITE_API_BASE_URL=https://api.example.com
